      "parameters": {
        "jsCode": "const output = $input.item.json.output;\n\nconst marginMatch = output.match(/Margin:\\s*([\\d.]+)%/);\nconst margin = parseFloat(marginMatch?.[1] ?? 0);\n\nlet score = 0;\nif (margin >= 30) score += 40;\nif (margin >= 50) score += 20;\nif (output.toLowerCase().includes('rising')) score += 30;\nif (output.toLowerCase().includes('low competition')) score += 10;\n\nreturn [{\n  json: {\n    ...($input.item.json),\n    product_score: score,\n    recommendation: score >= 60 ? 'Strong Buy' : score >= 40 ? 'Consider' : 'Pass'\n  }\n}];"
      },
