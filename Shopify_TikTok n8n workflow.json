        "jsCode": "const input = $input.item.json.input || \"\";\nconst priceMatch = input.match(/price[:\\s]+\\$?([\\d.]+)/i);\nconst costMatch = input.match(/cost[:\\s]+\\$?([\\d.]+)/i);\nconst price = parseFloat(priceMatch?.[1]) || 0;\nconst cost = parseFloat(costMatch?.[1]) || 0;\nconst profit = price - cost;\nconst margin = ((profit / price) * 100).toFixed(2);\nconst viable = parseFloat(margin) >= 30;\nreturn `Price: $${price}, Cost: $${cost}, Profit: $${profit.toFixed(2)}, Margin: ${margin}%, Viable: ${viable}`;"
