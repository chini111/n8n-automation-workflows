      "parameters": {
        "jsCode": "const output = $input.item.json.output;\n\n// Find the PRODUCTSJSON block\nconst match = output.match(/PRODUCTS_?JSON:(\\{.*\\})/s);\nif (!match) return [{ json: { product_name: output, selling_price: '', sourcing_cost: '', profit: '', margin: '', date: new Date().toISOString() } }];\n\ntry {\n  const data = JSON.parse(match[1]);\n  const products = Array.isArray(data.products) ? data.products : Object.values(data.products);\n  \n  return products.map(p => ({\n    json: {\n      product_name: p.name,\n      selling_price: p.price,\n      sourcing_cost: p.cost,\n      profit: p.profit,\n      margin: p.margin,\n      viable: p.viable,\n      date: new Date().toISOString()\n    }\n  }));\n} catch(e) {\n  return [{ json: { product_name: 'Parse error: ' + e.message, date: new Date().toISOString() } }];\n}"
      },
